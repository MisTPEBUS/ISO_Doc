    {
      "name": "Admin - Document Versions",
      "item": [
        {
          "name": "Create Version (multipart)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// effectiveDate 預設為明天（不得早於今天）",
                  "const d = new Date();",
                  "d.setUTCDate(d.getUTCDate() + 1);",
                  "pm.environment.set('effectiveDate', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('versionId', pm.response.json().versionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "version",
                  "value": "2.1",
                  "type": "text",
                  "description": "手動版號，例如 1、1.0、2.1"
                },
                {
                  "key": "effectiveDate",
                  "value": "{{effectiveDate}}",
                  "type": "text",
                  "description": "yyyy-MM-dd，不得早於今天"
                },
                {
                  "key": "pageCount",
                  "value": "1",
                  "type": "text",
                  "description": "選填，> 0"
                },
                {
                  "key": "memo",
                  "value": "初版",
                  "type": "text",
                  "description": "選填"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "必填，.pdf，內容前置 %PDF-"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}/versions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}", "versions"]
            },
            "description": "CompanyAdminScope + CSRF。multipart/form-data，file 必填。建立即 PUBLISHED，先前 PUBLISHED 轉 OBSOLETE。201 { versionId, version, status }。400 欄位 / 非 PDF。403。404 文件不存在。409 文件停用 / 併發。\n\n請自行在 file 欄位選一個 PDF 檔。"
