# 複製為 .env.deploy 後填入實際值（.env.deploy 不進版控）
# 使用方式：docker compose -f docker-compose-deploy.yml --env-file .env.deploy up -d --build
# 值裡若有 $，需寫成 $$，否則會被 docker compose 當成變數展開。

# GCP Postgres 連線字串
ISO_DB_CONNECTION=Host=your-db-host;Port=5432;Database=iso;Username=your-user;Password=change-me

# GCP bucket 與 VM 上的 service account JSON（不要放進專案目錄）
# container 以 uid 1654 執行，JSON 檔需讓該 uid 可讀
GCP_STORAGE_BUCKET=sodu-iso-documents
GCP_SERVICE_ACCOUNT_PATH=/opt/iso/secrets/gcp-service-account.json

# AI 匯入分析用；留空時 AI 匯入功能無法使用，其餘功能不受影響
OPENAI_API_KEY=

# iso-frontend 綁在 127.0.0.1 的 port，給主機上的 reverse proxy 轉發
ISO_FRONTEND_PORT=8081

# 反向代理連到 iso-frontend 時的來源 IP/CIDR；僅信任這個代理轉送的使用者 IP。
# 請填實際位址，不可填 0.0.0.0/0。
TRUSTED_UPSTREAM_PROXY=
