# 複製為 .env.nas 後填入實際值（.env.nas 不進版控）
# 使用方式：docker compose -f docker-compose.nas.yml --env-file .env.nas <command>

POSTGRES_DB=iso_production
POSTGRES_USER=root
POSTGRES_PASSWORD=Mis@2788

# postgres 資料是二進位檔案，不需要透過 File Station 瀏覽，放在 docker 共用資料夾下即可
NAS_POSTGRES_DATA_PATH=/volume1/docker/iso/postgres-data

# 保留原有地端 storage-data 掛載；正式環境新檔案寫入 GCP bucket
NAS_STORAGE_DATA_PATH=/volume1/ISO

# GCP bucket 與 NAS 上的唯讀 service account JSON（不要放進專案目錄）
GCP_STORAGE_BUCKET=sodu-iso-documents
GCP_SERVICE_ACCOUNT_PATH=/volume1/docker/iso/secrets/gcp-service-account.json

# frontend(nginx) 只綁 127.0.0.1 的 port，給 DSM Reverse Proxy 轉發用
NAS_FRONTEND_PORT=8081

# DSM 連到 frontend container 時的來源 IP/CIDR；僅信任這個代理轉送的使用者 IP。
# 請填實際位址，不可填 0.0.0.0/0；通常可從 frontend container 的連線日誌確認。
TRUSTED_UPSTREAM_PROXY=
