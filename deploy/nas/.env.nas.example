# 複製為 .env.nas 後填入實際值（.env.nas 不進版控）
# 使用方式：docker compose -f docker-compose.nas.yml --env-file .env.nas <command>

POSTGRES_DB=iso_production
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me

# postgres 資料是二進位檔案，不需要透過 File Station 瀏覽，放在 docker 共用資料夾下即可
NAS_POSTGRES_DATA_PATH=/volume1/docker/iso/postgres-data

# 附件/文件檔案要能用 File Station 直接瀏覽，所以放在獨立的「ISO」共用資料夾下
# （/volume1/ISO 必須先在 DSM 控制台 -> 共用資料夾 建立好，SSH 手動 mkdir 不會出現在 File Station）
NAS_STORAGE_DATA_PATH=/volume1/ISO

# frontend(nginx) 只綁 127.0.0.1 的 port，給 DSM Reverse Proxy 轉發用
NAS_FRONTEND_PORT=8081
